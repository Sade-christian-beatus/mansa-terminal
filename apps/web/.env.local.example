# ── Backend API ───────────────────────────────────────────────────────────────
# En local : http://localhost:8000
# En production Vercel : laisser vide — les rewrites vercel.json gèrent le proxy
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── APIs tierces (dashboard) ─────────────────────────────────────────────────
# NewsAPI.org — clé gratuite sur https://newsapi.org/register
# Sans clé, le dashboard affiche des articles de démonstration
NEWS_API_KEY=

# ── Notes ────────────────────────────────────────────────────────────────────
# Frankfurter.app (FX) et IMF DataMapper sont gratuits et sans clé.
# Ils sont appelés directement depuis les routes /api/fx et /api/imf.
#
# En production Vercel, les appels /api/backend/* sont redirigés vers Railway
# via les rewrites définis dans vercel.json.
# Il faut aussi définir dans Vercel Dashboard :
#   NEXT_PUBLIC_API_URL  → (laisser vide ou mettre l'URL Railway directe)
#   NEWS_API_KEY         → ta clé NewsAPI
