# ============================================================
# MANSA Terminal — Variables d'environnement (Backend Railway)
# Copier ce fichier en .env pour le développement local
# Sur Railway : configurer ces vars dans l'onglet "Variables"
# ============================================================

# --- Application ---
APP_ENV=production
SECRET_KEY=CHANGE_ME_32_CHARS_MIN_xxxxxxxxxxxxxxxx
DEBUG=false
LOG_LEVEL=INFO

# --- Base de données (Supabase) ---
# Onglet "Connect" > "Transaction pooler" (port 6543) pour l'API async
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# "Session pooler" (port 5432) ou connexion directe pour Alembic
DATABASE_URL_SYNC=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# --- Redis (Railway Redis plugin ou Upstash) ---
REDIS_URL=redis://default:[PASSWORD]@[HOST]:[PORT]/0

# --- Auth JWT ---
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_32_CHARS_MIN_xxx

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=sk-ant-...

# --- CORS (URL Vercel du frontend) ---
CORS_ORIGINS_RAW=https://[YOUR-PROJECT].vercel.app,https://app.mansa.ai

# --- Stripe (optionnel Phase 2) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Observabilite (optionnel) ---
SENTRY_DSN=
