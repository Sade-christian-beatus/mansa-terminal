# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production
APP_NAME=MANSA Terminal
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ── Base de données (Railway fournit DATABASE_URL automatiquement) ─────────────
# Format attendu : postgresql://user:pass@host:port/dbname
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Même URL pour Alembic (psycopg2 sync) — Railway la fournit aussi
DATABASE_URL_SYNC=postgresql://user:password@host:5432/dbname

# ── Redis ─────────────────────────────────────────────────────────────────────
# Railway injecte REDIS_URL automatiquement si tu lies un service Redis
REDIS_URL=redis://localhost:6379/0

# ── Auth JWT ──────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_32_chars_minimum_secret_key_here
JWT_SECRET_KEY=change_me_32_chars_minimum_jwt_key_here_xx
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS — URL(s) du frontend Vercel séparées par des virgules ────────────────
CORS_ORIGINS_RAW=https://your-app.vercel.app,https://your-custom-domain.com

# ── Anthropic (Claude AI) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_ID=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=2000

# ── Sentry (optionnel) ────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Stripe (Phase 2) ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=

# ── APIs de données ───────────────────────────────────────────────────────────
IMF_PORTWATCH_KEY=
ACLED_API_KEY=
ACLED_EMAIL=
NASA_EARTHDATA_TOKEN=

# ── AWS (Phase 2) ─────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
S3_BUCKET_DATA_LAKE=mansa-data-lake
