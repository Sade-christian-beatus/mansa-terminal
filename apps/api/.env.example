# MANSA Terminal — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS commiter le fichier .env

# ── Application ──────────────────────────────────────────────────────────
APP_ENV=production
APP_NAME=MANSA Terminal
APP_VERSION=1.0.0

# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_32_chars_minimum
JWT_SECRET_KEY=CHANGE_ME_32_chars_minimum_different

# ── URLs ──────────────────────────────────────────────────────────────────
FRONTEND_URL=https://mansa-terminal.vercel.app
CORS_ORIGINS_RAW=https://mansa-terminal.vercel.app,http://localhost:3000

# ── Base de données (Supabase) ────────────────────────────────────────────
# Transaction pooler (port 6543) → asyncpg / FastAPI
DATABASE_URL=postgresql+asyncpg://postgres.PROJECTID:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Session pooler (port 5432) → psycopg2 / Alembic / scripts
DATABASE_URL_SYNC=postgresql://postgres.PROJECTID:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Redis (Upstash) ───────────────────────────────────────────────────────
REDIS_URL=rediss://default:PASSWORD@UPSTASH_HOST.upstash.io:6379

# ── AI — Anthropic Claude ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-XXXX
ANTHROPIC_MODEL_ID=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=2000

# ── Observabilité — Sentry ────────────────────────────────────────────────
# Sentry.io → Project → Settings → Client Keys (DSN)
SENTRY_DSN=https://XXXXXXXX@XXXXXXXX.ingest.sentry.io/XXXXXXXX
LOG_LEVEL=INFO

# ── JWT ───────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email (Resend) ───────────────────────────────────────────────────────
# Resend.com → API Keys → Create API Key
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Adresse expéditeur (domaine doit être vérifié dans Resend)
EMAIL_FROM=MANSA Terminal <noreply@mansa-terminal.com>

# ── Sources de données externes (optionnelles) ───────────────────────────
# NASA FIRMS — feux actifs (firms.modaps.eosdis.nasa.gov → Map Key)
NASA_FIRMS_MAP_KEY=
# ACLED — conflits (acleddata.com, nouveau portail OAuth 2024)
ACLED_API_KEY=
ACLED_EMAIL=

# ── Bouton "Mettre à jour les données" (ré-ingestion à la demande) ────────
# Déclenche le workflow GitHub Actions data-ingest.yml via workflow_dispatch.
# Token GitHub (PAT fine-grained) avec permission Actions: Read & write sur le repo.
# Laisser vide pour désactiver le bouton (le pipeline tourne quand même en planifié).
GITHUB_INGEST_TOKEN=
GITHUB_REPO=Sade-christian-beatus/mansa-terminal
GITHUB_INGEST_WORKFLOW=data-ingest.yml
GITHUB_INGEST_REF=main

# ── Stripe (Phase 2 — laisser vide pour le MVP) ───────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
