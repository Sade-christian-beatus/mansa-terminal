# ============================================================
# MANSA TERMINAL — Variables d'environnement
# Copier en .env et remplir les valeurs
# NE JAMAIS COMMITTER .env dans git
# ============================================================

# --- Application ---
APP_ENV=development          # development | staging | production
APP_NAME=MANSA Terminal
APP_VERSION=1.0.0
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
DEBUG=true

# --- Base de données (PostgreSQL + TimescaleDB) ---
DATABASE_URL=postgresql+asyncpg://mansa:mansa_dev_password@localhost:5432/mansa_db
DATABASE_URL_SYNC=postgresql://mansa:mansa_dev_password@localhost:5432/mansa_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis (cache + pub/sub) ---
REDIS_URL=redis://localhost:6379/0

# --- Anthropic (Claude API) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_ID=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=2000

# --- Observabilité ---
SENTRY_DSN=https://...@sentry.io/...   # Laisser vide pour désactiver
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR

# --- Auth (JWT) ---
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# RS256 en production (générer avec : openssl genrsa -out private.pem 2048)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# --- Stripe (paiements) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...       # $5,000/an
STRIPE_PRICE_PROFESSIONAL=price_...  # $10,000/an
STRIPE_PRICE_ENTERPRISE=price_...    # $15,000/an

# --- APIs de données gratuites ---
# IMF — pas de clé requise pour les APIs publiques
IMF_BASE_URL=https://www.imf.org/external/datamapper/api/v1
IMF_PORTWATCH_URL=https://portwatch.imf.org/api/v1
IMF_PORTWATCH_KEY=

# World Bank — pas de clé requise
WB_BASE_URL=https://api.worldbank.org/v2

# BCEAO — pas de clé requise
BCEAO_BASE_URL=https://www.bceao.int/api

# ACLED (données de conflit) — inscription gratuite
ACLED_API_KEY=
ACLED_EMAIL=kodzovi@mansa.ai

# Google Trends — pas de clé (pytrends)
GOOGLE_TRENDS_GEO=africa

# NASA VIIRS (nightlights) — inscription NASA Earthdata
NASA_EARTHDATA_TOKEN=

# --- AWS (Phase 2) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
S3_BUCKET_DATA_LAKE=mansa-data-lake

# --- Email (notifications) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@mansa.ai
SMTP_PASSWORD=

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=MANSA Terminal
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
